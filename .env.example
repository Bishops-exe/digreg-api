# Copy to `.env` and fill in real values to run the integration tests
# (`cargo test`). Without these the credential tests skip themselves.

SCHOOL_SUBDOMAIN=myschool
SCHOOL_USERNAME=my.user
SCHOOL_PASSWORD=my-password

# Optional: only needed if the account has two-factor auth enabled.
SCHOOL_TWO_FACTOR=

# Optional: the student's user id. Needed only by the grades example and the
# grades integration test (the library does not scrape it from the session
# config yet).
SCHOOL_STUDENT_ID=
